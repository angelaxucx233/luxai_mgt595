# Copy to .env and fill with your credentials (never commit .env)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-3-flash

# TTS provider for Lux voice: elevenlabs | gemini
VITE_TTS_PROVIDER=elevenlabs
NARRATION_TTS_PROVIDER=elevenlabs

# ElevenLabs — Lisa Manoban voice, v3 model (keeps [excited] audio tags in narration)
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
VITE_ELEVENLABS_VOICE_ID=dR1Ptm3rjBUIbHiaywdJ
VITE_ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=dR1Ptm3rjBUIbHiaywdJ
ELEVENLABS_MODEL=eleven_v3

# Gemini TTS fallback (when VITE_TTS_PROVIDER=gemini)
VITE_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
VITE_GEMINI_TTS_VOICE=Sulafat

# Stronger model for outline agents (optional override)
OUTLINE_GEMINI_MODEL=gemini-3.1-pro-preview
REFINE_GEMINI_MODEL=gemini-3.1-pro-preview
# Long HTTP timeout for outline agents (ms). Pro can take 5–15 min on large lectures.
GEMINI_HTTP_TIMEOUT_MS=900000
